# Shared leaderboard storage — Upstash Redis via the Vercel Marketplace.
# Connecting the Upstash store to this Vercel project injects these
# automatically (Storage → your Upstash DB → Connect to Project).
# For local dev, fetch them with: vercel env pull .env.local
KV_REST_API_URL=
KV_REST_API_TOKEN=

# A hand-created Upstash store (not via the Marketplace) uses these instead;
# the API accepts either pair.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
