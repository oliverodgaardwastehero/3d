# Shared leaderboard storage — Upstash Redis (REST).
# In the Vercel dashboard: Storage → Create → Upstash for Redis, connect it to
# this project, and these two are injected automatically (Redis.fromEnv()).
# For local `vercel dev`, run `vercel env pull .env` to fetch them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
